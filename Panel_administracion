<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel Admin - Gestión de Souvenirs 🌸</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --rosa-fondo: #fff0f3;
      --rosa-card: #ffffff;
      --rosa-primario: #ff758c;
      --rosa-oscuro: #d81159;
      --rosa-suave: #ffb3c1;
      --gris-texto: #4a4a4a;
      --sombra: 0 8px 20px rgba(255, 117, 140, 0.15);
    }

    * { box-sizing: border-box; font-family: 'Poppins', sans-serif; margin: 0; padding: 0; }
    body { background-color: var(--rosa-fondo); color: var(--gris-texto); padding: 20px; }
    header { text-align: center; margin-bottom: 25px; }
    header h1 { color: var(--rosa-oscuro); font-size: 1.8rem; margin-bottom: 5px; }
    header p { color: #888; font-size: 0.9rem; }

    .layout { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px; max-width: 1200px; margin: 0 auto; }
    @media (max-width: 850px) { .layout { grid-template-columns: 1fr; } }

    .card { background: var(--rosa-card); border-radius: 16px; padding: 20px; box-shadow: var(--sombra); }
    .card h2 { color: var(--rosa-oscuro); font-size: 1.2rem; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }

    .form-group { margin-bottom: 12px; }
    .form-group label { display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 4px; color: #555; }
    .form-group input, .form-group select {
      width: 100%; padding: 10px; border: 1.5px solid var(--rosa-suave); border-radius: 8px; outline: none; font-size: 0.9rem;
    }
    .form-group input:focus, .form-group select:focus { border-color: var(--rosa-primario); }

    .grid-precios { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: #fff5f7; padding: 12px; border-radius: 10px; margin-bottom: 15px; }

    .btn {
      width: 100%; padding: 12px; border: none; border-radius: 10px; background: var(--rosa-primario);
      color: white; font-weight: 600; cursor: pointer; transition: 0.3s; font-size: 0.95rem;
    }
    .btn:hover { background: var(--rosa-oscuro); }
    .btn-secondary { background: #bbb; margin-top: 8px; display: none; }

    .productos-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
    .producto-item {
      background: white; border: 1px solid #ffe0e6; border-radius: 12px; overflow: hidden; position: relative;
      transition: transform 0.2s; box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    }
    .producto-item:hover { transform: translateY(-3px); }
    .producto-img { width: 100%; height: 130px; object-fit: cover; background: #fdf0f2; }
    .producto-info { padding: 12px; }
    .producto-info h4 { font-size: 0.95rem; color: var(--rosa-oscuro); margin-bottom: 4px; }
    .badge { display: inline-block; background: var(--rosa-suave); color: white; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 500; }
    .precios-preview { font-size: 0.75rem; margin-top: 8px; color: #666; border-top: 1px dashed #ffd1dc; padding-top: 6px; }

    .actions { display: flex; gap: 6px; margin-top: 10px; }
    .btn-sm { padding: 6px; font-size: 0.75rem; border-radius: 6px; border: none; cursor: pointer; flex: 1; font-weight: 600; }
    .btn-edit { background: #ffe082; color: #5d4037; }
    .btn-delete { background: #ff8a80; color: white; }
  </style>
</head>
<body>

  <header>
    <h1>👑 Panel Admin Souvenirs</h1>
    <p>Cargá, editá y mantené actualizado tu catálogo exclusivo</p>
  </header>

  <div class="layout">
    <!-- FORMULARIO -->
    <div class="card">
      <h2 id="form-title">✨ Cargar Nuevo Souvenir</h2>
      <form id="product-form">
        <input type="hidden" id="prod-id">

        <div class="form-group">
          <label>Nombre del Souvenir</label>
          <input type="text" id="nombre" placeholder="Ej: Denario Perlado con Cruz" required>
        </div>

        <div class="form-group">
          <label>Categoría</label>
          <select id="categoria" required>
            <option value="Denarios">Denarios</option>
            <option value="Llaveros">Llaveros</option>
            <option value="Señaladores">Señaladores</option>
            <option value="Rosarios">Rosarios</option>
          </select>
        </div>

        <div class="form-group">
          <label>Imagen (URL o archivo local)</label>
          <input type="text" id="imagen-url" placeholder="Pegá el link de la foto o elegí archivo abajo">
          <input type="file" id="imagen-file" accept="image/*" style="margin-top: 5px;">
        </div>

        <div class="grid-precios">
          <div class="form-group">
            <label>Precio Unitario (1-29u)</label>
            <input type="number" id="precio-u" placeholder="$" required>
          </div>
          <div class="form-group">
            <label>Precio (30 a 59u)</label>
            <input type="number" id="precio-30" placeholder="$" required>
          </div>
          <div class="form-group">
            <label>Precio (60 a 89u)</label>
            <input type="number" id="precio-60" placeholder="$" required>
          </div>
          <div class="form-group">
            <label>Precio (90+ u)</label>
            <input type="number" id="precio-90" placeholder="$" required>
          </div>
        </div>

        <button type="submit" class="btn" id="btn-save">💾 Guardar Souvenir</button>
        <button type="button" class="btn btn-secondary" id="btn-cancel" onclick="resetForm()">Cancelar Edición</button>
      </form>
    </div>

    <!-- LISTADO / VISTA PREVIA -->
    <div class="card">
      <h2>🛍️ Souvenirs Activos</h2>
      <div class="productos-list" id="productos-container"></div>
    </div>
  </div>

  <script>
    const DEFAULT_PRODUCTS = [
      { id: '1', nombre: 'Denario Perlado Rosa', categoria: 'Denarios', imagen: 'https://images.unsplash.com/photo-1590736704728-f4730bb30770?w=400', unit: 1500, p30: 1200, p60: 1000, p90: 850 },
      { id: '2', nombre: 'Llavero Angelito Dije', categoria: 'Llaveros', imagen: 'https://images.unsplash.com/photo-1611591475285-a36ad5e14391?w=400', unit: 1800, p30: 1450, p60: 1250, p90: 1050 },
      { id: '3', nombre: 'Señalador Borla & Cruz', categoria: 'Señaladores', imagen: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=400', unit: 1300, p30: 1050, p60: 900, p90: 750 },
      { id: '4', nombre: 'Rosario Madera Pastel', categoria: 'Rosarios', imagen: 'https://images.unsplash.com/photo-1601370690183-1c7796ecec61?w=400', unit: 2200, p30: 1800, p60: 1550, p90: 1300 }
    ];

    let productos = JSON.parse(localStorage.getItem('souvenirs_db')) || DEFAULT_PRODUCTS;
    if (!localStorage.getItem('souvenirs_db')) {
      localStorage.setItem('souvenirs_db', JSON.stringify(DEFAULT_PRODUCTS));
    }

    const form = document.getElementById('product-form');
    const container = document.getElementById('productos-container');

    // Muestra de imagen en base64 cuando suben un archivo
    let imageBase64 = '';
    document.getElementById('imagen-file').addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          imageBase64 = evt.target.result;
        };
        reader.readAsDataURL(file);
      }
    });

    function renderProductos() {
      container.innerHTML = '';
      productos.forEach(p => {
        const div = document.createElement('div');
        div.className = 'producto-item';
        div.innerHTML = `
          <img src="${p.imagen || 'https://via.placeholder.com/200x130/ffe0e6/ff758c?text=Sin+Imagen'}" class="producto-img">
          <div class="producto-info">
            <span class="badge">${p.categoria}</span>
            <h4>${p.nombre}</h4>
            <div class="precios-preview">
              <b>1u:</b> $${p.unit} | <b>30u+:</b> $${p.p30}<br>
              <b>60u+:</b> $${p.p60} | <b>90u+:</b> $${p.p90}
            </div>
            <div class="actions">
              <button class="btn-sm btn-edit" onclick="editProduct('${p.id}')">✏️ Editar</button>
              <button class="btn-sm btn-delete" onclick="deleteProduct('${p.id}')">🗑️ Borrar</button>
            </div>
          </div>
        `;
        container.appendChild(div);
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const id = document.getElementById('prod-id').value;
      const urlInput = document.getElementById('imagen-url').value;
      const finalImg = imageBase64 || urlInput || 'https://via.placeholder.com/200x130/ffe0e6/ff758c?text=Souvenir';

      const newProd = {
        id: id || Date.now().toString(),
        nombre: document.getElementById('nombre').value,
        categoria: document.getElementById('categoria').value,
        imagen: finalImg,
        unit: Number(document.getElementById('precio-u').value),
        p30: Number(document.getElementById('precio-30').value),
        p60: Number(document.getElementById('precio-60').value),
        p90: Number(document.getElementById('precio-90').value)
      };

      if (id) {
        productos = productos.map(p => p.id === id ? newProd : p);
      } else {
        productos.push(newProd);
      }

      localStorage.setItem('souvenirs_db', JSON.stringify(productos));
      resetForm();
      renderProductos();
    });

    function editProduct(id) {
      const p = productos.find(prod => prod.id === id);
      if (!p) return;
      document.getElementById('prod-id').value = p.id;
      document.getElementById('nombre').value = p.nombre;
      document.getElementById('categoria').value = p.categoria;
      document.getElementById('imagen-url').value = p.imagen.startsWith('data:') ? '' : p.imagen;
      document.getElementById('precio-u').value = p.unit;
      document.getElementById('precio-30').value = p.p30;
      document.getElementById('precio-60').value = p.p60;
      document.getElementById('precio-90').value = p.p90;

      document.getElementById('form-title').innerText = '✏️ Editar Souvenir';
      document.getElementById('btn-save').innerText = '🔄 Actualizar Souvenir';
      document.getElementById('btn-cancel').style.display = 'block';
    }

    function deleteProduct(id) {
      if (confirm('¿Segura que querés borrar este souvenir?')) {
        productos = productos.filter(p => p.id !== id);
        localStorage.setItem('souvenirs_db', JSON.stringify(productos));
        renderProductos();
      }
    }

    function resetForm() {
      form.reset();
      imageBase64 = '';
      document.getElementById('prod-id').value = '';
      document.getElementById('form-title').innerText = '✨ Cargar Nuevo Souvenir';
      document.getElementById('btn-save').innerText = '💾 Guardar Souvenir';
      document.getElementById('btn-cancel').style.display = 'none';
    }

    renderProductos();
  </script>
</body>
</html>
